# OpenAI
OPENAI_API_KEY=
# gpt-5.4: buen equilibrio calidad/costo, sin requerir verificación extra de cuenta.
# La familia gpt-5.6 (sol/terra/luna) es más nueva y puede tener rollout gateado (401 hasta
# que OpenAI habilite tu organización) — probala si te interesa, pero no es el default.
OPENAI_MODEL=gpt-5.4

# Base de datos: connection string de Postgres de Supabase.
# Supabase → Settings → Database → Connection string → "Transaction pooler" (puerto 6543).
# Incluye la contraseña de la base (esto sí es secreto). OJO: no dejes los corchetes [ ] del placeholder.
DATABASE_URL=

# Telegram
# Token del bot, se lo pedís a @BotFather con /newbot.
TELEGRAM_BOT_TOKEN=
# IDs de Telegram autorizados a usar el bot, separados por coma. Si está vacío, nadie puede usarlo:
# mandale un mensaje al bot y te responde con tu ID para que lo agregues acá.
TELEGRAM_ALLOWED_USER_IDS=

# Recordatorio diario (todos opcionales, tienen default). El bot manda una vez por día el resumen
# de la agenda a los IDs autorizados. Requiere que el bot esté prendido a esa hora.
AGENDA_HORA=09:00
AGENDA_TIMEZONE=America/Argentina/Buenos_Aires
AGENDA_DIAS_ANTICIPACION=30

# Supabase Storage (OPCIONAL — solo para documentos/fotos en fase 2, no se usa en el v1).
# Ojo: la key de servicio empieza con sb_secret_ (NO la publishable sb_publishable_).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ARquilerAPI (RapidAPI) — actualización automática de alquileres por IPC. Sin RAPIDAPI_KEY,
# la tool avisa que no está configurada; el resto del bot funciona igual.
RAPIDAPI_KEY=
RAPIDAPI_HOST=arquilerapi1.p.rapidapi.com

# Debug: si es "true", loguea por consola tokens de entrada/salida/total y costo estimado
# de cada llamada a OpenAI. Para desarrollo — no dejar prendido en producción (es ruidoso).
DEBUG_AI=false

# Deploy (dejar vacío en desarrollo local — se usa long-polling y no hace falta nada de esto).
# En Render, PORT y RENDER_EXTERNAL_URL los define la plataforma sola; WEBHOOK_URL solo hace
# falta si desplegás en otro host que no exponga su propia URL pública automáticamente.
# PORT=
# WEBHOOK_URL=

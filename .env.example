# Anthropic (Claude)
ANTHROPIC_API_KEY=
# Modelo. claude-opus-4-8 (máxima calidad) o claude-sonnet-5 (más barato, suficiente para este caso)
CLAUDE_MODEL=claude-opus-4-8

# Base de datos: connection string de Postgres de Supabase.
# Supabase → Settings → Database → Connection string → "Transaction pooler" (puerto 6543).
# Incluye la contraseña de la base (esto sí es secreto).
DATABASE_URL=

# Telegram
# Token del bot, se lo pedís a @BotFather con /newbot.
TELEGRAM_BOT_TOKEN=
# IDs de Telegram autorizados a usar el bot, separados por coma. Si está vacío, nadie puede usarlo:
# mandale un mensaje al bot y te responde con tu ID para que lo agregues acá.
TELEGRAM_ALLOWED_USER_IDS=

# Supabase Storage (OPCIONAL — solo para documentos/fotos en fase 2, no se usa en el v1).
# Ojo: la key de servicio empieza con sb_secret_ (NO la publishable sb_publishable_).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
